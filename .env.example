# Server
SUMMARIZE_BASE_URL=http://127.0.0.1:8420
PORT=8080
DATA_DIR=./data
LOG_LEVEL=info

# Defaults
SUMMARIZE_ENGINE=pi
SUMMARIZE_PROMPT="Summarize the following content clearly and accurately. Include a concise overview, key points, and action items if any."

# Engines
SUMMARIZE_PI_BIN=pi
SUMMARIZE_AGY_BIN=agy
SUMMARIZE_PI_MODEL=
SUMMARIZE_AGY_MODEL=
SUMMARIZE_RUN_TIMEOUT=15m
SUMMARIZE_MAX_INPUT_CHARS=100000

# YouTube
SUMMARIZE_YTDLP_BIN=yt-dlp
SUMMARIZE_TRANSCRIPT_LANGS=en.*,en
SUMMARIZE_YTDLP_TIMEOUT=60s

# NATS
NATS_HOST=127.0.0.1
NATS_PORT=-1
NATS_SUBJECT_SUMMARY_REQUESTED=summaries.requested

# MCP auth (none | static | oauth)
MCP_ENABLE=1
MCP_AUTH_MODE=none
# MCP_API_KEY=secret-key-for-static-mode
# MCP_OAUTH_ISSUER=https://auth.example.com
# MCP_OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# MCP_OAUTH_AUDIENCE=summarize-mcp
# MCP_ANONYMOUS_REF=install-abc123
# When MCP_AUTH_MODE=none, sets a deployment-stable first-party identifier
# used as anonymousRef for Epode telemetry. If unset, defaults to "local".
# Each installation should set a unique value to keep telemetry partitioned.

# Agent Feedback / Epode Telemetry (disabled by default)
# Set AGENT_FEEDBACK_KEY to enable Epode v2 telemetry for completed MCP tool calls.
# Events are sent to POST /api/v2/telemetry/batches with:
#   - Customer identity: userRef (authenticated) or anonymousRef (anonymous)
#   - Session: run UUID as sessionRef, sessionSource "mcp"
#   - Response: fresh interactionId per call, surface "mcp", classification "confirmed"
# Delivery requires HTTP 202 with accepted == batch size, dropped == 0.
# Retries bounded (4 attempts) on network/408/429/5xx. Product calls never wait.
# AGENT_FEEDBACK_KEY=af_live_your_key_here
# AGENT_FEEDBACK_ENDPOINT=https://app.epode.ai
# AGENT_FEEDBACK_RUNTIME_HINT=summarize-prototype
